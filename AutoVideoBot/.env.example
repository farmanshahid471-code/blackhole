# ============================================================================
#  AutoVideoBot - SECRETS FILE
# ============================================================================
#  1. Copy this file and rename the copy to exactly:  .env
#         Windows:  copy .env.example .env
#         Mac/Linux: cp .env.example .env
#
#  2. Fill in ONLY the keys you use. Leave the rest empty.
#
#  3. NEVER share your .env file or upload it to GitHub.
#     (There is a .gitignore that already blocks it.)
# ============================================================================

# ---------------------------------------------------------------------------
#  DEEPSEEK  (script + image prompts + titles)
#  Get a key: https://platform.deepseek.com/api_keys
#  deepseek-chat = normal model (cheaper)
#  deepseek-reasoner = thinking model (smarter, slower)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
#  GENERIC OpenAI-COMPATIBLE LLM
#  Use this for Groq / OpenRouter / Together / LM Studio / vLLM / OpenAI.
#  Just change the BASE_URL + MODEL + KEY.
#    Groq      -> https://api.groq.com/openai/v1        llama-3.3-70b-versatile
#    OpenRouter-> https://openrouter.ai/api/v1          deepseek/deepseek-chat-v3
#    Together  -> https://api.together.xyz/v1           deepseek-ai/DeepSeek-V3
#    LM Studio -> http://localhost:1234/v1              your-local-model
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
#  OLLAMA  (100% free, runs offline on your own PC)
#  Install: https://ollama.com     then:  ollama pull llama3.1
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
#  ELEVENLABS  (best quality paid TTS, voice cloning)
#  https://elevenlabs.io/app/settings/api-keys
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
#  OPENAI TTS
# ---------------------------------------------------------------------------
OPENAI_TTS_VOICE=alloy

# ---------------------------------------------------------------------------
#  VOICESTUDIO  (https://github.com/debpalash/VoiceStudio)
#  Start the server first, then put its address here.
#  Local PC   -> http://localhost:3900
#  Vast.ai GPU-> http://<your-vast-ip>:<your-vast-port>
# ---------------------------------------------------------------------------
VOICESTUDIO_URL=http://localhost:3900
VOICESTUDIO_VOICE=default

# ---------------------------------------------------------------------------
#  VAST.AI  (rent a cloud GPU for image generation)
#  https://cloud.vast.ai/account/  ->  Account -> API Key
# ---------------------------------------------------------------------------
VAST_API_KEY=

# ---------------------------------------------------------------------------
#  REPLICATE  (pay-per-image hosted FLUX / SDXL - no GPU management at all)
#  https://replicate.com/account/api-tokens
# ---------------------------------------------------------------------------
REPLICATE_API_TOKEN=

# ---------------------------------------------------------------------------
#  STABLE DIFFUSION WEBUI (AUTOMATIC1111 / Forge / ComfyUI bridge)
#  Wherever it is running: your PC, Colab, Vast.ai, Kaggle.
#  Start it with:  python launch.py --api --listen --port 7860
# ---------------------------------------------------------------------------
SDWEBUI_URL=http://127.0.0.1:7860

# ---------------------------------------------------------------------------
#  COLAB / KAGGLE / GRADIO  temporary public link
#  Your Colab notebook prints a link like:
#     https://abcd-12-34-56-78.ngrok-free.app
#  Paste it here (or pass it on the command line with --endpoint).
# ---------------------------------------------------------------------------
IMAGE_ENDPOINT_URL=

# ---------------------------------------------------------------------------
#  IMAGE STYLE (optional global override)
# ---------------------------------------------------------------------------
IMAGE_STYLE_SUFFIX=
